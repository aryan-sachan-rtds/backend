generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource mydb {
  provider = "postgresql"
}

model User {
  id         Int      @id @default(autoincrement())
  email      String   @unique
  name       String
  password   String
  created_at DateTime @default(now()) @mydb.Timestamptz(3)
  posts      Post[]
}
